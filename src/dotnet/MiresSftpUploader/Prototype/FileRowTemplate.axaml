<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="using:MiresSftpUploader.Prototype">
    <!-- PROTOTYPE: row shared by all variants. Columns: dot | path+note | size | outcome | progress -->
    <DataTemplate x:Key="FileRowTemplate" x:DataType="p:FileRow">
        <Grid ColumnDefinitions="22,*,80,100,150" Margin="0,5">
            <Ellipse Classes="dot" Classes.ok="{Binding IsOk}" Classes.fail="{Binding IsFail}" Classes.active="{Binding IsActive}"/>
            <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" Classes.muted="{Binding IsMuted}"/>
                <TextBlock Text="{Binding Note}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="muted" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="{Binding Outcome}" VerticalAlignment="Center"/>
            <ProgressBar Grid.Column="4" Value="{Binding Progress}" Maximum="100" Height="6" VerticalAlignment="Center"
                         IsVisible="{Binding IsActive}"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
