<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MiresSftpUploader.App"
             RequestedThemeVariant="Dark">
    <!-- Dark unless Ui:Theme says otherwise (the window applies it). The M* brushes come from Themes/MiresTheme.axaml,
         generated from the Django tokens in src/MiqaResearch/static/css/mires.css by tools/generate_uploader_theme.py. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/MiresTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#CE80FF" RegionColor="#171717"/>
                <ColorPaletteResources x:Key="Light" Accent="#CE80FF" RegionColor="#F5F5F5"/>
            </FluentTheme.Palettes>
        </FluentTheme>

        <Style Selector="Window, UserControl"><Setter Property="Foreground" Value="{DynamicResource MForeground}"/></Style>
        <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MSecondary}"/></Style>
        <Style Selector="TextBlock.h"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="Consolas,Menlo,monospace"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="TextBlock.tile"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="Bold"/></Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource MCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style Selector="Border.sunken"><Setter Property="Background" Value="{DynamicResource MSunken}"/></Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MPrimary}"/>
            <Setter Property="Foreground" Value="{DynamicResource MPrimaryFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MPrimary}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MDestructive}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <!-- Top-bar navigation, as .top-bar nav a in mires.css: muted text, a muted fill on hover, the accent fill for the current page. -->
        <Style Selector="Button.nav">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.nav.icon">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MSecondary}"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MPopover}"/>
            <Setter Property="Foreground" Value="{DynamicResource MForeground}"/>
        </Style>
        <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource MAccentFg}"/>
        </Style>
        <!-- The Succeeded / Failed / Skipped / Pending tiles are toggle buttons: they look like cards, and a checked one has the accent border (its background is unchanged). -->
        <Style Selector="ToggleButton.tile">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="ToggleButton.tile /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="ToggleButton.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MPopover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MBorder}"/>
        </Style>
        <Style Selector="ToggleButton.tile:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tile:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource MPrimary}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource MPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource MBorder}"/>
        </Style>
        <!-- The file list: a status icon per outcome (colour as well), and every other row striped. -->
        <Style Selector="PathIcon.status"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/></Style>
        <Style Selector="PathIcon.status.muted"><Setter Property="Foreground" Value="{DynamicResource MMuted}"/></Style>
        <Style Selector="PathIcon.status.ok"><Setter Property="Foreground" Value="{DynamicResource MSuccess}"/></Style>
        <Style Selector="PathIcon.status.fail"><Setter Property="Foreground" Value="{DynamicResource MDestructive}"/></Style>
        <Style Selector="PathIcon.status.active"><Setter Property="Foreground" Value="{DynamicResource MPrimary}"/></Style>
        <Style Selector="ItemsControl.files ContentPresenter:nth-child(2n)"><Setter Property="Background" Value="{DynamicResource MSunken}"/></Style>
        <Style Selector="Ellipse.dot"><Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/><Setter Property="Fill" Value="{DynamicResource MMuted}"/></Style>
        <Style Selector="Ellipse.dot.ok"><Setter Property="Fill" Value="{DynamicResource MSuccess}"/></Style>
        <Style Selector="Ellipse.dot.fail"><Setter Property="Fill" Value="{DynamicResource MDestructive}"/></Style>
        <Style Selector="Ellipse.dot.active"><Setter Property="Fill" Value="{DynamicResource MPrimary}"/></Style>
    </Application.Styles>
</Application>
