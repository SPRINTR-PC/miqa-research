<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:MiresSftpUploader.Prototype"
             x:Class="MiresSftpUploader.Prototype.HistoryRail" x:DataType="p:ProtoVm">
    <!-- PROTOTYPE: variant B's left rail with page tabs (Upload / History) and the run filter. -->
    <Border Classes="sunken" BorderBrush="{DynamicResource MBorder}" BorderThickness="0,0,1,0" Padding="16" Width="230">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                <Button HorizontalAlignment="Stretch" Content="{Binding ThemeLabel}" Command="{Binding ThemeCmd}"/>
                <Button HorizontalAlignment="Stretch" Content="⚙ Settings" Command="{Binding SettingsCmd}"/>
            </StackPanel>
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <p:MiresLogo Height="34" Width="40"/>
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MPrimary}" VerticalAlignment="Center" Text="MIRES Uploader"/>
                </StackPanel>
                <Button HorizontalAlignment="Stretch" Margin="0,8,0,0" Content="⬆  Upload" Command="{Binding UploadPageCmd}"/>
                <Button Classes="primary" HorizontalAlignment="Stretch" Content="🕘  History" Command="{Binding HistoryPageCmd}"/>
                <TextBlock Classes="h" Text="Show" Margin="0,12,0,0"/>
                <ListBox ItemsSource="{Binding RunFilters}" SelectedIndex="{Binding RunFilter}"/>
                <Border Classes="card" IsVisible="{Binding HasToast}" Margin="0,10,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding Toast}"/>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
