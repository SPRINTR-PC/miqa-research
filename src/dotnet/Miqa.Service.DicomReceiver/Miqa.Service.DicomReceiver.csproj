<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="../Miqa.Core/appsettings.json" Link="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="fo-dicom" Version="5.2.6" />
      <PackageReference Include="fo-dicom.NLog" Version="5.0.3" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.7" />
      <PackageReference Include="NLog.Extensions.Logging" Version="6.1.2" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="../Miqa.Infrastructure/Miqa.Infrastructure.csproj" />
    </ItemGroup>

</Project>
