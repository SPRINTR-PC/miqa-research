<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:MiresSftpUploader.Prototype"
             x:Class="MiresSftpUploader.Prototype.RunDetail" x:DataType="p:RunVm">
    <!-- PROTOTYPE: one Run in detail. Shared by the History variants (header, banners, counts, controls, outcomes table). -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse Classes="dot" Classes.ok="{Binding DotOk}" Classes.fail="{Binding DotFail}" Classes.active="{Binding DotActive}" Classes.warn="{Binding DotWarn}"/>
                <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding Title}"/>
                <TextBlock VerticalAlignment="Center" Text="{Binding Status}"/>
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding ExitText}"/>
            </StackPanel>
            <TextBlock Classes="muted" Text="{Binding Subtitle}"/>
            <Border Classes="card" IsVisible="{Binding IsLiveOthers}" BorderBrush="{DynamicResource MInfo}">
                <StackPanel Spacing="6">
                    <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Live view of "/><Run FontWeight="SemiBold" Text="{Binding StartedBy}"/><Run Text="'s Run. It is read-only: you can watch it or ask it to stop."/></TextBlock>
                    <TextBlock Classes="muted" Text="{Binding Heartbeat, StringFormat='Last heartbeat {0}'}"/>
                </StackPanel>
            </Border>
            <Border Classes="card" IsVisible="{Binding ShowCancelRequested}" BorderBrush="{DynamicResource MWarning}">
                <TextBlock TextWrapping="Wrap" Text="Cancel requested. The Run stops at its next cancel poll (within 5 seconds); in-flight .part files are left on the server."/>
            </Border>
            <Border Classes="card" IsVisible="{Binding IsAbandoned}" BorderBrush="{DynamicResource MWarning}">
                <TextBlock TextWrapping="Wrap" Text="Abandoned: the process stopped without finishing (heartbeat went stale). Unfinished files are marked Failed and are retried by the next Run; use Retry to start it now."/>
            </Border>
            <Border Classes="card" IsVisible="{Binding IsDry}"><TextBlock TextWrapping="Wrap" Text="{Binding DryNote}"/></Border>
            <StackPanel IsVisible="{Binding IsRunning}" Spacing="4">
                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="10"/>
                <TextBlock Classes="muted" Text="{Binding ProgressText}"/>
            </StackPanel>
            <UniformGrid Rows="1">
                <Border Classes="card" Margin="0,0,8,0"><StackPanel><TextBlock Classes="muted" Text="Succeeded"/><TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource MSuccess}" Text="{Binding Ok}"/></StackPanel></Border>
                <Border Classes="card" Margin="0,0,8,0"><StackPanel><TextBlock Classes="muted" Text="Failed"/><TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource MDestructive}" Text="{Binding Failed}"/></StackPanel></Border>
                <Border Classes="card" Margin="0,0,8,0"><StackPanel><TextBlock Classes="muted" Text="{Binding TooRecent, StringFormat='Skipped (incl. {0} too recent)'}"/><TextBlock FontSize="24" FontWeight="Bold" Text="{Binding Skipped}"/></StackPanel></Border>
                <Border Classes="card"><StackPanel><TextBlock Classes="muted" Text="Moved away"/><TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource MInfo}" Text="{Binding Moved}"/></StackPanel></Border>
            </UniformGrid>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Classes="danger" Content="{Binding CancelLabel}" Command="{Binding CancelCmd}" IsEnabled="{Binding CanCancel}" IsVisible="{Binding IsRunning}"/>
                    <Button Classes="primary" Content="↻ Retry failed" Command="{Binding RetryCmd}" IsEnabled="{Binding CanRetry}"/>
                    <Button Content="⇩ JSON" Command="{Binding ExportJsonCmd}"/>
                    <Button Content="⇩ CSV" Command="{Binding ExportCsvCmd}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="h" Text="Outcomes" VerticalAlignment="Center"/>
                    <ToggleButton Content="Failed only" IsChecked="{Binding FailedOnly}"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
        <Border Classes="card" Padding="12,6" Margin="0,10,0,0"><ScrollViewer><ItemsControl ItemsSource="{Binding VisibleFiles}" ItemTemplate="{StaticResource FileRowTemplate}"/></ScrollViewer></Border>
    </DockPanel>
</UserControl>
