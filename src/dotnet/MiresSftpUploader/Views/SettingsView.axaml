<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MiresSftpUploader.ViewModels"
             x:Class="MiresSftpUploader.Views.SettingsView" x:DataType="vm:SettingsPageViewModel">
    <UserControl.DataTemplates>
        <!-- One Secret: where it comes from, a masked box that is emptied after Save, and Save / Clear. A stored value is never shown. -->
        <DataTemplate DataType="vm:SecretEntryViewModel">
            <StackPanel Spacing="2">
                <Grid ColumnDefinitions="180,160,*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}"/>
                    <TextBlock x:Name="SecretStatusText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Status}"/>
                    <TextBox x:Name="SecretInput" Grid.Column="2" PasswordChar="●" Text="{Binding Input}" IsEnabled="{Binding !IsLocked}" PlaceholderText="New value"/>
                    <Button x:Name="SecretSaveButton" Grid.Column="3" Content="Save" Command="{Binding SaveCommand}"/>
                    <Button x:Name="SecretClearButton" Grid.Column="4" Content="Clear" Command="{Binding ClearCommand}"/>
                </Grid>
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding !StoreAvailable}" Text="{Binding StoreProblem}"/>
                <TextBlock Foreground="{DynamicResource MDestructive}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding Error}"/>
            </StackPanel>
        </DataTemplate>
        <!-- A list of Archive Rules: global, or one Source's own. The first rule that matches a file wins. -->
        <DataTemplate DataType="vm:ArchiveRulesViewModel">
            <StackPanel Spacing="6" IsEnabled="{Binding IsEditable}">
                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ArchiveRuleEditorViewModel">
                            <Border Classes="sunken" Padding="10" Margin="0,0,0,8" CornerRadius="6">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,160,100,Auto" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Classes="muted" Text="Rule name"/>
                                            <TextBox Text="{Binding Name}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Classes="muted" Text="One Archive per"/>
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:ArchiveRuleEditorViewModel.GroupingNames}" SelectedItem="{Binding Grouping}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Classes="muted" Text="Min files"/>
                                            <TextBox Text="{Binding MinFiles}"/>
                                        </StackPanel>
                                        <Button Grid.Column="3" VerticalAlignment="Bottom" Classes="danger" Content="Remove"
                                                Command="{Binding $parent[ItemsControl].((vm:ArchiveRulesViewModel)DataContext).RemoveRuleCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Classes="muted" Text="Pattern (regular expression, matched against the path inside the Source)"/>
                                        <TextBox Classes="mono" Text="{Binding Pattern}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="muted" Text="Archive name ({rule}, {dir} and {date} are replaced)"/>
                                        <TextBox Text="{Binding ArchiveName}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted" FontSize="11" IsVisible="{Binding IsEmpty}" Text="No Archive Rules: every file is uploaded on its own."/>
                <Button HorizontalAlignment="Left" Content="Add Archive Rule" Command="{Binding AddRuleCommand}"/>
                <TextBlock Foreground="{DynamicResource MDestructive}" TextWrapping="Wrap" IsVisible="{Binding HasError}" Text="{Binding Error}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>
    <DockPanel>
        <!-- Save bar -->
        <Border DockPanel.Dock="Bottom" Classes="sunken" BorderBrush="{DynamicResource MBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RevertButton" Content="Revert" Command="{Binding RevertCommand}"/>
                    <Button x:Name="SaveButton" Classes="primary" Content="Save" Command="{Binding SaveCommand}"/>
                </StackPanel>
                <TextBlock x:Name="SaveMessageText" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding SaveMessage}"/>
            </DockPanel>
        </Border>

        <ScrollViewer>
            <StackPanel Spacing="14" Margin="0,0,12,0">
                <TextBlock Classes="h" Text="Settings"/>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="The Sources and the Destination (Sftp) settings are saved to the Machine Config (appsettings.json) that every user of this machine shares; the other settings are saved to your User Overrides. Locked Settings come from an environment variable or from a Machine Config you cannot write. Secrets are never edited here."/>

                <!-- Data Directory banner -->
                <Border x:Name="DataDirectoryBanner" Classes="card" BorderBrush="{DynamicResource MDestructive}" IsVisible="{Binding HasDataDirectoryProblem}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="h" Text="The Data Directory cannot be used"/>
                        <TextBlock TextWrapping="Wrap" Text="{Binding DataDirectoryProblem}"/>
                        <TextBlock Classes="muted" Text="No Run can start until an administrator runs:"/>
                        <TextBox Classes="mono" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding DataDirectoryFixCommand, Mode=OneWay}"/>
                    </StackPanel>
                </Border>

                <!-- Validation summary -->
                <Border x:Name="ErrorsCard" Classes="card" BorderBrush="{DynamicResource MDestructive}" IsVisible="{Binding HasErrors}">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="h" Text="Fix these before you can save"/>
                        <ItemsControl ItemsSource="{Binding OtherErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Classes="mono" TextWrapping="Wrap" Foreground="{DynamicResource MDestructive}" Text="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Classes="mono" TextWrapping="Wrap" Foreground="{DynamicResource MWarning}" Text="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Sources -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <DockPanel>
                            <Button x:Name="AddSourceButton" DockPanel.Dock="Right" Content="Add Source" Command="{Binding AddSourceCommand}"/>
                            <TextBlock Classes="h" Text="Sources" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Classes="muted" IsVisible="{Binding SourcesLocked}" TextWrapping="Wrap"
                                   Text="The Sources are Locked Settings here: they come from an environment variable, or the Machine Config (appsettings.json) is not writable by this account."/>
                        <ItemsControl x:Name="SourcesList" ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SourceEditorViewModel">
                                    <Border Classes="sunken" Padding="12" Margin="0,0,0,10" CornerRadius="6">
                                        <StackPanel Spacing="6" IsEnabled="{Binding IsEditable}">
                                            <Grid ColumnDefinitions="*,140,Auto,Auto" ColumnSpacing="8">
                                                <StackPanel>
                                                    <TextBlock Classes="muted" Text="Name"/>
                                                    <TextBox Text="{Binding Name}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Classes="muted" Text="Type"/>
                                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:SettingsPageViewModel.SourceTypes}" SelectedItem="{Binding TypeName}"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" VerticalAlignment="Bottom" Content="Enabled" IsChecked="{Binding Enabled}"/>
                                                <Button Grid.Column="3" VerticalAlignment="Bottom" Classes="danger" Content="Remove"
                                                        Command="{Binding $parent[ItemsControl].((vm:SettingsPageViewModel)DataContext).RemoveSourceCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>

                                            <!-- Directory -->
                                            <StackPanel IsVisible="{Binding IsDirectory}">
                                                <TextBlock Classes="muted" Text="Directory path"/>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Browse…" Command="{Binding BrowseCommand}"/>
                                                    <TextBox Text="{Binding Path}"/>
                                                </DockPanel>
                                            </StackPanel>

                                            <!-- S3 -->
                                            <StackPanel IsVisible="{Binding IsS3}" Spacing="6">
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <StackPanel>
                                                        <TextBlock Classes="muted" Text="Endpoint URL"/>
                                                        <TextBox Text="{Binding Endpoint}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Classes="muted" Text="Bucket"/>
                                                        <TextBox Text="{Binding Bucket}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                                    <StackPanel>
                                                        <TextBlock Classes="muted" Text="Prefix"/>
                                                        <TextBox Text="{Binding Prefix}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Classes="muted" Text="Region (optional)"/>
                                                        <TextBox Text="{Binding Region}"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" VerticalAlignment="Bottom" Content="Path-style addressing" IsChecked="{Binding ForcePathStyle}"/>
                                                </Grid>
                                                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding SecretStatus}"/>
                                                <ContentControl Content="{Binding AccessKey}"/>
                                                <ContentControl Content="{Binding SecretKey}"/>
                                            </StackPanel>

                                            <StackPanel>
                                                <TextBlock Classes="muted" Text="Remote Path (optional)"/>
                                                <TextBox Text="{Binding RemotePath}" PlaceholderText="{Binding RemotePathPlaceholder}"/>
                                            </StackPanel>

                                            <Expander Header="Archive Rules for this Source" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <ContentControl Content="{Binding ArchiveRules}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"/>
                                            </Expander>
                                            <TextBlock Foreground="{DynamicResource MDestructive}" TextWrapping="Wrap" IsVisible="{Binding HasError}" Text="{Binding Error}"/>
                                            <TextBlock Foreground="{DynamicResource MWarning}" TextWrapping="Wrap" IsVisible="{Binding HasWarning}" Text="{Binding Warning}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Archive Rules -->
                <Border x:Name="ArchiveRulesCard" Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="h" Text="Archive Rules"/>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Files whose path matches a rule are packed into one zip Archive and uploaded instead of the loose files. A Source's own rules are tried first, then these; the first rule that matches a file wins, and a group with fewer files than Min files stays loose."/>
                        <TextBlock Classes="muted" IsVisible="{Binding ArchiveRules.IsLocked}" TextWrapping="Wrap"
                                   Text="The Archive Rules are Locked Settings here: they come from an environment variable or from a Machine Config you cannot write."/>
                        <ContentControl Content="{Binding ArchiveRules}"/>
                    </StackPanel>
                </Border>

                <!-- Secrets -->
                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="h" Text="Secrets"/>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="A Secret comes from an environment variable, which wins, or from the Secret Store: encrypted for this account on this machine. It guards a copied or leaked file, not someone already running as you. Values are never shown."/>
                        <ContentControl Content="{Binding SftpPassword}"/>
                        <ContentControl Content="{Binding SftpKeyPassphrase}"/>
                    </StackPanel>
                </Border>

                <!-- Connection check -->
                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="h" Text="Connection"/>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Opens one session with the Destination settings above, as edited (saved or not), to prove the server answers and the credentials work. Nothing is uploaded. If the Host Key Fingerprint is empty, you are shown the server's and asked whether to use it."/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckConnectionButton" Content="Check connection" Command="{Binding CheckConnectionCommand}"/>
                        </StackPanel>
                        <TextBlock x:Name="ConnectionCheckText" TextWrapping="Wrap" IsVisible="{Binding HasConnectionCheckMessage}" Text="{Binding ConnectionCheckMessage}"/>
                    </StackPanel>
                </Border>

                <!-- Data Directory check -->
                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="h" Text="Data Directory"/>
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="Holds the Upload State, Staging Areas, logs and Reports shared by every account on this machine."/>
                        <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding DataDirectoryPath}"/>
                        <TextBlock x:Name="DataDirectoryStatusText" Text="{Binding DataDirectoryStatus}"/>
                        <TextBlock Text="{Binding DataDirectoryFreeSpace}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="muted" Text="Upload State database:"/>
                            <TextBlock Text="{Binding DataDirectoryDatabaseSize}"/>
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource MWarning}" TextWrapping="Wrap" IsVisible="{Binding DataDirectoryOnNetworkShare}"
                                   Text="This looks like a network share. SQLite locking over a network share is unreliable; use a local disk if you can."/>
                        <TextBlock x:Name="SplitStateWarningText" Foreground="{DynamicResource MWarning}" TextWrapping="Wrap" IsVisible="{Binding HasSplitStateWarning}" Text="{Binding SplitStateWarning}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button x:Name="RecheckButton" Content="Re-check" Command="{Binding RecheckDataDirectoryCommand}"/>
                            <Button x:Name="CopyFixCommandButton" Content="Copy fix command" IsVisible="{Binding HasDataDirectoryProblem}" Command="{Binding CopyFixCommandCommand}"/>
                        </StackPanel>
                        <TextBlock x:Name="StagingWarningText" Foreground="{DynamicResource MWarning}" TextWrapping="Wrap" IsVisible="{Binding HasStagingWarning}" Text="{Binding StagingWarning}"/>
                    </StackPanel>
                </Border>

                <!-- Every other setting, grouped -->
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsGroupViewModel">
                            <Border Classes="card" Margin="0,0,0,14">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h" Text="{Binding Title}"/>
                                    <ItemsControl ItemsSource="{Binding Fields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SettingFieldViewModel">
                                                <StackPanel Spacing="2" Margin="0,0,0,6">
                                                    <TextBlock Classes="muted" Text="{Binding Label}"/>
                                                    <TextBox IsVisible="{Binding IsText}" IsEnabled="{Binding IsEditable}" Text="{Binding Value}"/>
                                                    <TextBox IsVisible="{Binding IsLines}" IsEnabled="{Binding IsEditable}" AcceptsReturn="True" MinHeight="64" Text="{Binding Value}"/>
                                                    <CheckBox IsVisible="{Binding IsToggle}" IsEnabled="{Binding IsEditable}" IsChecked="{Binding BoolValue}" Content="{Binding Label}"/>
                                                    <ComboBox IsVisible="{Binding IsChoice}" IsEnabled="{Binding IsEditable}" MinWidth="200" ItemsSource="{Binding Options}" SelectedItem="{Binding Value}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Content="Browse…" IsVisible="{Binding HasBrowse}" IsEnabled="{Binding IsEditable}" Command="{Binding BrowseCommand}"/>
                                                        <Button Content="Change…" IsVisible="{Binding HasUnlockButton}" Command="{Binding UnlockCommand}"/>
                                                    </StackPanel>
                                                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding Help}"/>
                                                    <TextBlock Foreground="{DynamicResource MWarning}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasNote}" Text="{Binding Note}"/>
                                                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasLockReason}" Text="{Binding LockReason, StringFormat='Locked. {0}'}"/>
                                                    <TextBlock Foreground="{DynamicResource MDestructive}" TextWrapping="Wrap" IsVisible="{Binding HasError}" Text="{Binding Error}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
