<mxfile host="app.diagrams.net"><diagram id="mires-system" name="System"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;MIQA Research (MIRES) – system sketch&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontSize=22;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1700" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Base architecture, ETL-pipeline ingestion, DICOM (imaging + radiotherapy) and pathology data intake. Solid = data flow, dashed = control / secrets / auth." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1700" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;External data sources&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="300" height="740" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;DICOM imaging &amp;amp; RT&lt;/b&gt;&lt;br&gt;MR · CT · PET&lt;br&gt;RTDOSE · RTPLAN · RTSTRUCT&lt;br&gt;(also RTIMAGE, RDSR, other)&lt;br&gt;&lt;br&gt;&lt;i&gt;Files in a local folder or S3 bucket (&lt;code&gt;s3://bucket/prefix&lt;/code&gt;)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5f5;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="135" width="260" height="200" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Pathology data&lt;/b&gt;&lt;br&gt;• DICOM VL Whole Slide Microscopy (WSI)&lt;br&gt;• Hamamatsu &lt;code&gt;.ndpi&lt;/code&gt; slides&lt;br&gt;• Tabular results / reports&lt;br&gt;(CSV, XLSX, other formats via ETL scripts)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="260" height="230" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Clinical / research tables&lt;/b&gt;&lt;br&gt;Measurements, visits, consent&lt;br&gt;(CSV, XLSX, …) dropped in a bucket" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="260" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;Researchers · Data Managers · Admins · Annotators (browser)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="725" width="260" height="85" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Ingestion&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f9f9ff;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="350" y="90" width="640" height="740" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;DICOM ingestion pipeline&lt;/b&gt; (Celery task &lt;code&gt;ingest_dicom_source&lt;/code&gt;, queue &lt;i&gt;dicom-ingestion&lt;/i&gt;)&lt;br&gt;discovery → parse → participant match/create → UID pseudonymization → extractors (generic · radiotherapy · pathology · RDSR) → record upsert (Study / Series / File) → storage → report&lt;br&gt;&lt;i&gt;Per-file errors are reported; source-level errors fail the run.&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5f5;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="135" width="600" height="175" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;NDPI → DICOM converter&lt;/b&gt; (&lt;code&gt;convert_ndpi_to_dicom&lt;/code&gt;)&lt;br&gt;Lossless re-tiling of Hamamatsu NDPI into a VL WSI DICOM file set (JPEG tiles not re-encoded). Standalone today – ingestion runs do not call it; output enters the DICOM pipeline." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="325" width="600" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;ETL pipelines&lt;/b&gt; – files in an S3 bucket become rows in the research DB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="370" y="440" width="600" height="375" as="geometry"/></mxCell><mxCell id="c12" value="Source bucket&lt;br&gt;(Source Location)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="385" y="495" width="100" height="75" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Orchestrator&lt;/b&gt;&lt;br&gt;Celery poll + diff" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="515" y="495" width="120" height="75" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;ETL Job&lt;/b&gt;&lt;br&gt;script version, inputs, status" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="665" y="495" width="120" height="75" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Sandbox Runner&lt;/b&gt;&lt;br&gt;no network, no credentials, read-only input" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="815" y="495" width="140" height="75" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Datatype loader&lt;/b&gt;&lt;br&gt;validate rows, one atomic transaction" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="665" y="615" width="120" height="70" as="geometry"/></mxCell><mxCell id="c17" value="Raw bucket&lt;br&gt;(move or delete)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="515" y="615" width="100" height="75" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Pipeline Binding&lt;/b&gt;&lt;br&gt;Datatype + script + source + retention" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontSize=10;" vertex="1" parent="1"><mxGeometry x="385" y="615" width="100" height="75" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;How it works:&lt;/b&gt; a Data Manager binds an &lt;b&gt;ETL Script&lt;/b&gt; (Python/R, versioned; or a shipped Native Script) to a source bucket + &lt;b&gt;ETL Datatype&lt;/b&gt; (e.g. measurement, visit_occurrence → OMOP tables). The platform polls the bucket, runs the script in the sandbox on each new file/folder, validates the returned rows, loads them atomically, then moves sources to the Raw bucket (or deletes them, per Raw Retention). Failed jobs keep their sources and can be retried." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="385" y="705" width="570" height="95" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;MIQA Research platform&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4fbf4;strokeColor=#82b366;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1040" y="90" width="700" height="740" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Django web app&lt;/b&gt;&lt;br&gt;Granian ASGI · UI + REST API (Ninja)&lt;br&gt;Auth (local / OIDC / ADFS / WebAuthn MFA)&lt;br&gt;Project roles, audit log" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="135" width="300" height="100" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;DICOM viewer&lt;/b&gt; (Cornerstone3D web component)&lt;br&gt;Reads series via WADO-style fetch from the app; every access is audited" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="135" width="340" height="100" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Celery workers&lt;/b&gt;&lt;br&gt;DICOM ingestion · ETL orchestrator · OCR (PROM) · consent lookup · scheduled (beat)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="270" width="300" height="95" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;Message broker for Django/Celery tasks (queues per task family). Results stored in DB (django-db)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="270" width="340" height="95" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Research DB: OMOP-style tables (Person, Measurement, Visit), Study Participants, DICOM Study/Series/File metadata, ETL config + jobs, audit log" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="410" width="300" height="110" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;RustFS&lt;/b&gt; (S3-compatible object store)&lt;br&gt;ETL source + raw buckets; DICOM file storage and WSI pixel data (S3 API via boto3)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="410" width="340" height="110" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;HashiCorp Vault&lt;/b&gt;&lt;br&gt;KV v2 secrets: data-hash &amp;amp; Fernet keys, consent client id/secret (and other credentials). Read by app + workers at startup." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="565" width="300" height="100" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Identity provider&lt;/b&gt;&lt;br&gt;OIDC / Microsoft ADFS → role mapping to Django groups" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5f5;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="565" width="340" height="100" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Ollama&lt;/b&gt; (local VLM)&lt;br&gt;OCR of PROM forms: classic mark detection, VLM escalation" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="710" width="300" height="95" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Consent source&lt;/b&gt; (external, OAuth2)&lt;br&gt;Participant consent lookups by Celery task" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5f5;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="710" width="340" height="95" as="geometry"/></mxCell><mxCell id="c31" value="DICOM files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;endArrow=block;fontSize=11;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value=".ndpi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;endArrow=block;fontSize=11;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="WSI DICOM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;endArrow=block;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c10" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="DICOM WSI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;endArrow=block;fontSize=11;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="tables / reports" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;endArrow=block;fontSize=11;" edge="1" parent="1" source="c5" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="CSV / XLSX" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;endArrow=block;fontSize=11;" edge="1" parent="1" source="c6" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="poll" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;endArrow=block;fontSize=11;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="queue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;endArrow=block;fontSize=11;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="SandboxRunSpec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;endArrow=block;fontSize=11;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="result.jsonl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;endArrow=block;fontSize=11;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="on success: move" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;endArrow=block;fontSize=11;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="config" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="c18" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="enqueue tasks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;endArrow=block;fontSize=11;exitX=0.5;exitY=1;" edge="1" parent="1" source="c21" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;endArrow=block;fontSize=11;" edge="1" parent="1" source="c24" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="c23" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="ORM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#444444;endArrow=block;fontSize=11;" edge="1" parent="1" source="c21" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="mires-auth" name="Authentication"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Production authentication – OpenID Connect + YubiKey (WebAuthn)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontSize=22;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c2" value="Mode set by &lt;code&gt;MIRES_AUTHENTICATION_FRAMEWORK&lt;/code&gt;, e.g. &lt;code&gt;oidc,yubikey&lt;/code&gt;. Local email/password login exists only when DEBUG=True." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;User's browser&lt;/b&gt;" style="shape=image;imageAspect=1;image=data:image/svg+xml,;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="100" height="100" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;MIQA Research&lt;/b&gt;&lt;br&gt;Django + django-allauth&lt;br&gt;&lt;br&gt;OIDC client · WebAuthn MFA&lt;br&gt;Role mapping · Sessions · Audit log" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="200" width="260" height="170" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;imageAspect=1;image=data:image/svg+xml,;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="205" width="40" height="40" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Identity provider&lt;/b&gt;&lt;br&gt;OIDC server / Microsoft ADFS&lt;br&gt;&lt;br&gt;Verifies the user, returns ID token with email, name and role claims" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5f5;stro