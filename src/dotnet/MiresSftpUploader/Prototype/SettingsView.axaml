<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:MiresSftpUploader.Prototype"
             x:Class="MiresSftpUploader.Prototype.SettingsView" x:DataType="p:ProtoVm">
    <!-- PROTOTYPE settings screen (shared by all variants): locked / secret / fingerprint-confirm behaviours. -->
    <Border Classes="card" Padding="20" MaxWidth="760" Margin="24" VerticalAlignment="Center">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="✕ Close" Command="{Binding SettingsCmd}"/>
                <StackPanel>
                    <TextBlock Classes="h" FontSize="18" Text="Settings"/>
                    <TextBlock Classes="muted" Text="Saved per user in appsettings.user.json. Environment variables win and lock a field. Secrets are never shown or saved."/>
                </StackPanel>
            </DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="↻ Reload config"/>
                <Button Classes="primary" Content="Save" Command="{Binding SettingsCmd}"/>
            </StackPanel>
            <ScrollViewer MaxHeight="440">
                <StackPanel Spacing="10" Margin="0,0,12,0">
                    <TextBlock Classes="h" Text="SFTP server"/>
                    <Grid ColumnDefinitions="170,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Text="Host" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="sftp.mires.example" IsEnabled="False"/>
                        <TextBlock Grid.Column="2" Classes="muted" Margin="10,0,0,0" VerticalAlignment="Center" Text="🔒 locked by MIRES_Sftp__Host"/>
                        <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="22"/>
                        <TextBlock Grid.Row="2" Text="Username" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="mires-upload"/>
                        <TextBlock Grid.Row="3" Text="Password" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="●●●●●●●●●●" IsEnabled="False"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MSuccess}" Text="secret · set via MIRES_Sftp__Password"/>
                        <TextBlock Grid.Row="4" Text="Private key file" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Watermark="(none)"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Classes="muted" Margin="10,0,0,0" VerticalAlignment="Center" Text="passphrase: secret · not set"/>
                        <TextBlock Grid.Row="5" Text="Host key fingerprint" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="SHA256:2k9Qe…q7Ew" IsReadOnly="True"/>
                        <Button Grid.Row="5" Grid.Column="2" Margin="10,0,0,0" Content="Change…" Command="{Binding FpCmd}"/>
                    </Grid>
                    <Border Classes="card" Background="{DynamicResource MAccent}" IsVisible="{Binding FpConfirm}">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource MAccentFg}" Text="⚠ Changing the pinned fingerprint changes who the app trusts"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MAccentFg}" Text="Only continue if the server's key was rotated and you verified the new fingerprint out of band."/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="danger" Content="I verified it, allow edit" Command="{Binding FpCmd}"/>
                                <Button Content="Cancel" Command="{Binding FpCmd}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="＋ Add source" Command="{Binding AddSourceCmd}"/>
                        <TextBlock Classes="h" Text="Sources" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="p:SourceVm">
                                <Border Classes="card" Margin="0,0,0,8">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,140,Auto" ColumnSpacing="8">
                                            <TextBox Text="{Binding Name}" Watermark="Source name"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" SelectedIndex="{Binding TypeIndex}" HorizontalAlignment="Stretch"/>
                                            <Button Grid.Column="2" Content="🗑" Command="{Binding RemoveCmd}"/>
                                        </Grid>
                                        <!-- Directory fields -->
                                        <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto" IsVisible="{Binding IsDirectory}">
                                            <TextBlock Text="Directory" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding Path}" Watermark="/path/to/folder"/>
                                            <Button Grid.Column="2" Margin="8,0,0,0" Content="Browse…"/>
                                        </Grid>
                                        <!-- S3 fields -->
                                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" IsVisible="{Binding IsS3}">
                                            <TextBlock Text="Endpoint URL" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Endpoint}" Watermark="https://s3.example.org"/>
                                            <TextBlock Grid.Row="1" Text="Bucket" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Bucket}"/>
                                            <TextBlock Grid.Row="2" Text="Prefix" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Prefix}" Watermark="folder/ (optional)"/>
                                            <TextBlock Grid.Row="3" Text="Region" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Region}" Watermark="(optional)"/>
                                            <TextBlock Grid.Row="4" Text="Addressing" VerticalAlignment="Center"/><CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding PathStyle}" Content="Path-style (MinIO, Ceph)"/>
                                            <TextBlock Grid.Row="5" Text="Access / secret key" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Foreground="{DynamicResource MSuccess}" VerticalAlignment="Center" Text="secret · set via MIRES_Sources__N__SecretKey"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="140,*">
                                            <TextBlock Text="Remote path" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding RemotePath}" Watermark="{Binding RemotePathHint}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="h" Text="Transfers" Margin="0,8,0,0"/>
                    <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Text="Remote root" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="/incoming"/>
                        <TextBlock Grid.Row="1" Text="Max parallel uploads" VerticalAlignment="Center"/><NumericUpDown Grid.Row="1" Grid.Column="1" Value="3" Minimum="1" Maximum="16" HorizontalAlignment="Left" Width="140"/>
                        <TextBlock Grid.Row="2" Text="Archive grouping" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="One zip per directory"/><ComboBoxItem Content="One zip per rule"/></ComboBox>
                    </Grid>
                    <TextBlock Classes="h" Text="Rules" Margin="0,8,0,0"/>
                    <TextBlock Classes="muted" Text="Ignore patterns (regex on relative path, one per line)"/>
                    <TextBox AcceptsReturn="True" Height="70" Classes="mono" Text="(^|/)Thumbs\.db$&#x0a;\.tmp$"/>
                    <TextBlock Classes="muted" Text="Archive rules (regex, one per line)"/>
                    <TextBox AcceptsReturn="True" Height="50" Classes="mono" Text="^dicom-export/series-\d+/"/>
                    <TextBlock Classes="h" Text="Appearance" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Default theme" VerticalAlignment="Center"/>
                        <ComboBox SelectedIndex="0"><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/></ComboBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
