{
  "Sftp": {
    "Port": 22,
    "AuthMethod": "Password",
    "RemoteRoot": "/",
    "RemoteAccess": "Auto",
    "UploadStrategy": "PartThenRename",
    "ConnectTimeoutSeconds": 30,
    "KeepAliveSeconds": 30
  },
  "Ignore": {
    "UseDefaults": true,
    "Files": [],
    "Patterns": []
  },
  "Archive": {
    "Rules": [],
    "MaxParallelBuilds": 1,
    "MinFreeSpaceBytes": 1073741824,
    "WarnAboveBytes": 53687091200
  },
  "Scan": {
    "MinFileAgeSeconds": 0
  },
  "Manifest": {
    "JsonName": "manifest.json",
    "FlatName": "manifest.sha256",
    "WriteFlat": false,
    "InProgressSuffix": ".inprogress"
  },
  "Upload": {
    "MaxParallelUploads": 3,
    "VerifyAfterUpload": "Off",
    "RehashAll": false,
    "VerifyRemote": "Off",
    "VerifyCommand": "sha256sum -- {path}",
    "VerifyTimeoutSeconds": 3600,
    "MoveFailuresAreErrors": false
  },
  "Retry": {
    "MaxAttempts": 3,
    "BaseDelaySeconds": 2,
    "MaxDelaySeconds": 60
  },
  "State": {
    "RunFilesRetentionDays": 180,
    "MissingRetentionDays": 90,
    "HeartbeatSeconds": 15,
    "StaleAfterSeconds": 60,
    "CancelPollSeconds": 5
  },
  "Report": {
    "Format": "Json",
    "FileNamePattern": "run-{runId}.{format}"
  },
  "Logging": {
    "Level": "Info",
    "RetainDays": 14
  },
  "Ui": {
    "LogLevel": "Info"
  }
}
