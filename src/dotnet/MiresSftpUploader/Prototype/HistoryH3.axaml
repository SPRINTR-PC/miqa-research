<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:MiresSftpUploader.Prototype"
             x:Class="MiresSftpUploader.Prototype.HistoryH3" x:DataType="p:ProtoVm">
    <!-- PROTOTYPE history variant H3 "Timeline feed": runs grouped by day, each an expander with its outcomes inline; live Runs float on top as cards. -->
    <Grid ColumnDefinitions="Auto,*">
        <p:HistoryRail/>
        <ScrollViewer Grid.Column="1" Margin="20">
            <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Stretch">
                <TextBlock FontSize="20" FontWeight="Bold" Text="History"/>
                <ItemsControl ItemsSource="{Binding VisibleRuns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="p:RunVm">
                            <StackPanel>
                                <TextBlock IsVisible="{Binding ShowDay}" Classes="h" Margin="0,14,0,6" Text="{Binding Day}"/>
                                <Border Classes="card" Padding="4" Margin="0,0,0,6">
                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="26,*,Auto" Margin="0,4">
                                                <Ellipse Classes="dot" Classes.ok="{Binding DotOk}" Classes.fail="{Binding DotFail}" Classes.active="{Binding DotActive}" Classes.warn="{Binding DotWarn}"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock><Run FontWeight="SemiBold" Text="{Binding Title}"/><Run Text="  "/><Run Text="{Binding Started}"/><Run Text="  ·  "/><Run Text="{Binding Status}"/></TextBlock>
                                                    <TextBlock Classes="muted" Text="{Binding Subtitle}"/>
                                                    <ProgressBar IsVisible="{Binding IsRunning}" Value="{Binding Progress}" Maximum="100" Height="6"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Counts}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Spacing="8" Margin="26,6,6,10">
                                            <TextBlock IsVisible="{Binding IsLiveOthers}" Foreground="{DynamicResource MInfo}" TextWrapping="Wrap">
                                                <Run Text="Live view of "/><Run Text="{Binding StartedBy}"/><Run Text="'s Run (read-only). Last heartbeat "/><Run Text="{Binding Heartbeat}"/>
                                            </TextBlock>
                                            <TextBlock IsVisible="{Binding ShowCancelRequested}" Foreground="{DynamicResource MWarning}" Text="Cancel requested: stops at the next cancel poll (≤5 s)."/>
                                            <TextBlock IsVisible="{Binding IsAbandoned}" Foreground="{DynamicResource MWarning}" TextWrapping="Wrap" Text="Abandoned: the process stopped; unfinished files were marked Failed and are retried by the next Run."/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Classes="danger" Content="{Binding CancelLabel}" Command="{Binding CancelCmd}" IsEnabled="{Binding CanCancel}" IsVisible="{Binding IsRunning}"/>
                                                <Button Classes="primary" Content="↻ Retry failed" Command="{Binding RetryCmd}" IsEnabled="{Binding CanRetry}"/>
                                                <Button Content="⇩ JSON" Command="{Binding ExportJsonCmd}"/>
                                                <Button Content="⇩ CSV" Command="{Binding ExportCsvCmd}"/>
                                                <ToggleButton Content="Failed only" IsChecked="{Binding FailedOnly}"/>
                                                <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Moved, StringFormat='{}{0} moved away'}"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding VisibleFiles}" ItemTemplate="{StaticResource FileRowTemplate}"/>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
