<?xml version="1.0" encoding="UTF-8"?>
<!-- UNUSED until macOS signing is enabled (see docs/signing.md). Nothing references this file by default. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- .NET needs a JIT under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Native libraries (SQLite, Skia, HarfBuzz, Avalonia) are self-extracted at start and are not signed with our identity. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
