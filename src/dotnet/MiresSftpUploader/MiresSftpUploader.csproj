<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="Version.props" />
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Files shipped next to the executable in artifacts/publish/<rid>/ (appsettings.json is above). Missing optional
         files are reported by the MiresReleaseFiles target; the publish scripts treat README.md as required. -->
    <ItemGroup>
        <ReleaseFile Include="README.md" TargetPath="README.md" />
        <ReleaseFile Include="docs/manifest.schema.json" TargetPath="manifest.schema.json" Condition="Exists('docs/manifest.schema.json')" />
        <ReleaseFile Include="docs/scheduler/**" TargetPath="scheduler/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <Import Project="Signing.targets" />

    <Target Name="MiresReleaseFiles" AfterTargets="Publish">
        <Copy SourceFiles="@(ReleaseFile)" DestinationFiles="@(ReleaseFile->'$(PublishDir)%(TargetPath)')" />
        <Warning Condition="!Exists('docs/manifest.schema.json')" Text="docs/manifest.schema.json not found; the Manifest JSON Schema is not in the publish output." />
        <Warning Condition="!Exists('docs/scheduler')" Text="docs/scheduler not found; no scheduler samples in the publish output." />
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\MiresSftpUploader.Core\MiresSftpUploader.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="NLog" Version="6.2.2" />
        <PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
        <PackageReference Include="ReactiveUI.Avalonia" Version="12.0.3" />
    </ItemGroup>
</Project>
