<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiresSftpUploader.ViewModels"
        xmlns:v="using:MiresSftpUploader.Views"
        x:Class="MiresSftpUploader.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Icon="/Assets/avalonia-logo.ico"
        Title="MIRES SFTP Uploader">
    <Grid ColumnDefinitions="270,*">
        <!-- Sidebar -->
        <Border Classes="sunken" BorderBrush="{DynamicResource MBorder}" BorderThickness="0,0,1,0" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding ThemeNotice}" IsVisible="{Binding HasThemeNotice}"/>
                    <Button x:Name="ThemeButton" HorizontalAlignment="Stretch" Content="{Binding ThemeToggleLabel}" Command="{Binding ToggleThemeCommand}"/>
                    <Button x:Name="SettingsButton" HorizontalAlignment="Stretch" Content="Settings" Command="{Binding ShowSettingsCommand}"/>
                    <Button x:Name="HelpButton" HorizontalAlignment="Stretch" Content="Help" Command="{Binding ShowHelpCommand}"/>
                </StackPanel>
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <v:MiresLogo Height="34" Width="40"/>
                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MPrimary}" VerticalAlignment="Center" TextWrapping="Wrap" Text="MIRES SFTP Uploader"/>
                        </StackPanel>
                        <Button x:Name="UploadButton" Classes="primary" HorizontalAlignment="Stretch" Margin="0,8,0,0" Content="Upload" Command="{Binding ShowUploadCommand}"/>

                        <TextBlock Classes="h" Text="Sources" Margin="0,8,0,0"/>
                        <ItemsControl ItemsSource="{Binding Upload.Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SourceItemViewModel">
                                    <StackPanel Margin="0,0,0,6">
                                        <CheckBox IsChecked="{Binding Included}" Content="{Binding Name}"/>
                                        <TextBlock Classes="muted" FontSize="11" Margin="28,-4,0,0" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="h" Text="Destination" Margin="0,8,0,0"/>
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Upload.Destination}"/>

                        <Button x:Name="StartButton" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,12,0,0" Content="Start" Command="{Binding Upload.StartCommand}"/>
                        <Button x:Name="DryRunButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Dry run" Command="{Binding Upload.DryRunCommand}"/>
                        <Button x:Name="ScanButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Scan" Command="{Binding Upload.ScanCommand}"/>
                        <Button x:Name="CancelButton" Classes="danger" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Cancel" Command="{Binding Upload.CancelCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <DockPanel x:Name="UploadPage" Grid.Column="1" Margin="20" IsVisible="{Binding IsUploadPage}">
            <Border x:Name="BlockedBanner" DockPanel.Dock="Top" Classes="card" Margin="0,0,0,14" BorderBrush="{DynamicResource MDestructive}"
                    IsVisible="{Binding Upload.IsBlocked}">
                <StackPanel Spacing="4">
                    <TextBlock Classes="h" Text="Uploading is disabled"/>
                    <TextBlock TextWrapping="Wrap" Text="{Binding Upload.BlockedReason}"/>
                    <TextBlock Classes="muted" Text="Settings shows the access check and the command that fixes it."/>
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,14" BorderBrush="{DynamicResource MDestructive}"
                    IsVisible="{Binding Upload.HasProblems}">
                <StackPanel Spacing="4">
                    <TextBlock Classes="h" Text="The configuration has problems"/>
                    <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding Upload.Problems}"/>
                </StackPanel>
            </Border>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*,*" Margin="0,0,0,14">
                <Border Classes="card" Margin="0,0,8,0"><StackPanel>
                    <TextBlock Classes="muted" Text="Succeeded"/>
                    <TextBlock x:Name="SucceededTile" Classes="tile" Foreground="{DynamicResource MSuccess}" Text="{Binding Upload.Succeeded}"/>
                </StackPanel></Border>
                <Border Grid.Column="1" Classes="card" Margin="0,0,8,0"><StackPanel>
                    <TextBlock Classes="muted" Text="Failed"/>
                    <TextBlock x:Name="FailedTile" Classes="tile" Foreground="{DynamicResource MDestructive}" Text="{Binding Upload.Failed}"/>
                </StackPanel></Border>
                <Border Grid.Column="2" Classes="card" Margin="0,0,8,0"><StackPanel>
                    <TextBlock Classes="muted" Text="Skipped"/>
                    <TextBlock x:Name="SkippedTile" Classes="tile" Text="{Binding Upload.Skipped}"/>
                </StackPanel></Border>
                <Border Grid.Column="3" Classes="card"><StackPanel>
                    <TextBlock Classes="muted" Text="Pending"/>
                    <TextBlock x:Name="PendingTile" Classes="tile" Foreground="{DynamicResource MInfo}" Text="{Binding Upload.Pending}"/>
                </StackPanel></Border>
            </Grid>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding Upload.Status}"/>
                <ProgressBar x:Name="OverallProgress" Value="{Binding Upload.OverallProgress}" Maximum="100" Height="10" Margin="0,0,16,0" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="Retry failed" Command="{Binding Upload.RetryFailedCommand}"/>
                <ToggleButton x:Name="FailedOnlyToggle" DockPanel.Dock="Right" Margin="0,0,8,0" Content="Failed only" IsChecked="{Binding Upload.FailedOnly}"/>
                <TextBlock Classes="h" Text="Files"/>
            </DockPanel>
            <!-- The files container; the log sits inside it, at its full width. -->
            <Border Classes="card" Padding="12,6">
                <DockPanel>
                    <Expander x:Name="LogExpander" DockPanel.Dock="Bottom" Header="Log" Margin="0,8,0,0"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsVisible="{Binding HasLog}">
                        <v:LogPaneView DataContext="{Binding Log}"/>
                    </Expander>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Upload.Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileRowViewModel">
                                    <Grid ColumnDefinitions="22,*,110" Margin="0,5">
                                        <Ellipse Classes="dot" Classes.ok="{Binding IsSucceeded}" Classes.fail="{Binding IsFailed}" Classes.active="{Binding IsActive}"/>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" Classes.muted="{Binding IsMuted}"/>
                                            <TextBlock Text="{Binding Reason}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding OutcomeText}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- Settings (Help is a placeholder until its page arrives) -->
        <Border x:Name="SettingsPage" Grid.Column="1" Margin="20" IsVisible="{Binding IsSettingsPage}">
            <v:SettingsView DataContext="{Binding Settings}"/>
        </Border>
        <StackPanel x:Name="HelpPage" Grid.Column="1" Margin="20" Spacing="8" IsVisible="{Binding IsHelpPage}">
            <TextBlock Classes="h" Text="Help"/>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="The Help page is not built yet. Run MiresSftpUploader --help for the command line."/>
        </StackPanel>
    </Grid>
</Window>
