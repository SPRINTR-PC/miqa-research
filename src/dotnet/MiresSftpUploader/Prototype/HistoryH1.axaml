<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:MiresSftpUploader.Prototype"
             x:Class="MiresSftpUploader.Prototype.HistoryH1" x:DataType="p:ProtoVm">
    <!-- PROTOTYPE history variant H1 "Master-detail": runs list on the left, selected Run in full on the right. -->
    <Grid ColumnDefinitions="Auto,330,*">
        <p:HistoryRail/>
        <ListBox Grid.Column="1" Margin="12" ItemsSource="{Binding VisibleRuns}" SelectedItem="{Binding SelectedRun}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="p:RunVm">
                    <StackPanel Spacing="3" Margin="0,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Classes="dot" Classes.ok="{Binding DotOk}" Classes.fail="{Binding DotFail}" Classes.active="{Binding DotActive}" Classes.warn="{Binding DotWarn}"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}"/>
                            <TextBlock Classes="muted" Text="{Binding Day}"/>
                            <TextBlock Classes="muted" Text="{Binding Started}"/>
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{Binding Line2}"/>
                        <TextBlock Text="{Binding Counts}"/>
                        <ProgressBar IsVisible="{Binding IsRunning}" Value="{Binding Progress}" Maximum="100" Height="6"/>
                        <TextBlock Classes="muted" FontSize="11" Text="{Binding Status}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ContentControl Grid.Column="2" Margin="12,20,20,20" Content="{Binding SelectedRun}">
            <ContentControl.DataTemplates>
                <DataTemplate x:DataType="p:RunVm"><p:RunDetail/></DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </Grid>
</UserControl>
