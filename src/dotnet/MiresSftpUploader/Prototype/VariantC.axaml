<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:MiresSftpUploader.Prototype"
             x:Class="MiresSftpUploader.Prototype.VariantC" x:DataType="p:ProtoVm">
    <!-- PROTOTYPE variant C "Stepper": one focused panel at a time: Sources -> Plan -> Upload -> Results. -->
    <DockPanel Margin="28,20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding ThemeLabel}" Command="{Binding ThemeCmd}"/>
                <Button Content="⚙ Settings" Command="{Binding SettingsCmd}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Padding="14,8" CornerRadius="16" Classes.on="{Binding IsStep0}" Background="{DynamicResource MCard}"><TextBlock Text="1  Sources" FontWeight="SemiBold" Foreground="{DynamicResource MPrimary}" IsVisible="{Binding IsStep0}"/></Border>
                <TextBlock Text="1  Sources ✓" VerticalAlignment="Center" Foreground="{DynamicResource MSuccess}" IsVisible="{Binding Step0Done}"/>
                <TextBlock Text="›" Classes="muted" VerticalAlignment="Center"/>
                <TextBlock Text="2  Plan" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MPrimary}" IsVisible="{Binding IsStep1}"/>
                <TextBlock Text="2  Plan ✓" VerticalAlignment="Center" Foreground="{DynamicResource MSuccess}" IsVisible="{Binding Step1Done}"/>
                <TextBlock Text="›" Classes="muted" VerticalAlignment="Center"/>
                <TextBlock Text="3  Upload" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MPrimary}" IsVisible="{Binding IsStep2}"/>
                <TextBlock Text="3  Upload ✓" VerticalAlignment="Center" Foreground="{DynamicResource MSuccess}" IsVisible="{Binding Step2Done}"/>
                <TextBlock Text="›" Classes="muted" VerticalAlignment="Center"/>
                <TextBlock Text="4  Results" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MPrimary}" IsVisible="{Binding IsStep3}"/>
            </StackPanel>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding StatusText}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="‹ Back" Command="{Binding BackCmd}" IsEnabled="{Binding IsIdle}"/>
                <Button Classes="primary" Content="Scan →" Command="{Binding ScanCmd}" IsVisible="{Binding IsStep0}"/>
                <Button Content="Dry run" Command="{Binding DryRunCmd}" IsVisible="{Binding IsStep0}"/>
                <Button Classes="primary" Content="▶ Start upload" Command="{Binding StartCmd}" IsVisible="{Binding IsStep1}"/>
                <Button Classes="danger" Content="■ Cancel" Command="{Binding CancelCmd}" IsVisible="{Binding IsStep2}" IsEnabled="{Binding IsRunning}"/>
                <Button Classes="primary" Content="↻ Retry failed" Command="{Binding RetryCmd}" IsVisible="{Binding IsStep3}" IsEnabled="{Binding HasFailures}"/>
                <Button Content="New run" Command="{Binding BackCmd}" IsVisible="{Binding IsStep3}"/>
            </StackPanel>
        </DockPanel>
        <Panel>
            <StackPanel Spacing="12" IsVisible="{Binding IsStep0}" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="What do you want to upload?"/>
                <Border Classes="card"><StackPanel Spacing="8"><CheckBox IsChecked="True" Content="wsi-archive  (Directory · 7 files)"/><CheckBox IsChecked="True" Content="dicom-export  (S3 mires-bucket/export/ · 7 files)"/></StackPanel></Border>
                <Border Classes="card"><StackPanel><TextBlock Classes="muted" Text="Uploads to"/><TextBlock Text="{Binding Destination}"/><TextBlock Classes="muted" Margin="0,6,0,0" Text="Host key pinned · password set via environment"/></StackPanel></Border>
            </StackPanel>
            <DockPanel IsVisible="{Binding IsStep1}">
                <TextBlock DockPanel.Dock="Top" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" Text="Plan: review before uploading"/>
                <Border Classes="card" Padding="12,6"><ScrollViewer><ItemsControl ItemsSource="{Binding VisibleRows}" ItemTemplate="{StaticResource FileRowTemplate}"/></ScrollViewer></Border>
            </DockPanel>
            <DockPanel IsVisible="{Binding IsStep2}">
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Uploading…"/>
                    <ProgressBar Value="{Binding Overall}" Maximum="100" Height="14"/>
                    <TextBlock Classes="muted" Text="{Binding Summary}"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Classes="card sunken" Height="140" Margin="0,10,0,0"><ScrollViewer><ItemsControl ItemsSource="{Binding VisibleLogs}">
    <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="p:LogLine">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="mono muted" Text="{Binding Time}"/>
                <TextBlock Classes="mono" Width="38" Text="{Binding LevelName}"/>
                <TextBlock Classes="mono" Text="{Binding Text}"/>
            </StackPanel>
        </DataTemplate>
    </ItemsControl.ItemTemplate>
</ItemsControl></ScrollViewer></Border>
                <Border Classes="card" Padding="12,6"><ScrollViewer><ItemsControl ItemsSource="{Binding VisibleRows}" ItemTemplate="{StaticResource FileRowTemplate}"/></ScrollViewer></Border>
            </DockPanel>
            <DockPanel IsVisible="{Binding IsStep3}">
                <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Results"/>
                    <StackPanel Orientation="Horizontal" Spacing="28">
                        <StackPanel><TextBlock FontSize="34" FontWeight="Bold" Foreground="{DynamicResource MSuccess}" Text="{Binding Succeeded}"/><TextBlock Classes="muted" Text="succeeded"/></StackPanel>
                        <StackPanel><TextBlock FontSize="34" FontWeight="Bold" Foreground="{DynamicResource MDestructive}" Text="{Binding Failed}"/><TextBlock Classes="muted" Text="failed"/></StackPanel>
                        <StackPanel><TextBlock FontSize="34" FontWeight="Bold" Text="{Binding Skipped}"/><TextBlock Classes="muted" Text="skipped"/></StackPanel>
                    </StackPanel>
                    <ToggleButton HorizontalAlignment="Left" Content="Show failed only" IsChecked="{Binding FailedOnly}"/>
                </StackPanel>
                <Border Classes="card" Padding="12,6"><ScrollViewer><ItemsControl ItemsSource="{Binding VisibleRows}" ItemTemplate="{StaticResource FileRowTemplate}"/></ScrollViewer></Border>
            </DockPanel>
        </Panel>
    </DockPanel>
</UserControl>
